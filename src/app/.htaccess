# Logger: Apache config. The vhost's DocumentRoot must be <path>/src/app (this folder).
# Needs: a2enmod rewrite headers   (+ deflate, usually on by default)
# Vhost: AllowOverride All   (FileInfo + AuthConfig + Indexes + Limit is enough)

Options -Indexes

# Bootstrap file; executing it directly does nothing useful
<Files "_inc.php">
	Require all denied
</Files>

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Static pages
	RewriteRule ^admin/?$ admin.html [L]
	RewriteRule ^docs/?$ docs.html [L]
	RewriteRule ^help/?$ /docs [R=302,L]

	# PHP sources are never requested directly
	RewriteRule ^(api|features|shared)/ - [F,L]

	# Existing files (admin.*, docs.html, openapi.yaml, index.php) are served as they are
	RewriteCond %{REQUEST_FILENAME} -f
	RewriteRule .+ - [L]

	# Everything else goes to the Magrathea router
	RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/(.*)$ index.php?magrathea_control=$1&magrathea_action=$2&magrathea_params=$3 [QSA,L]
	RewriteRule ^([a-zA-Z0-9_-]+)/(.*)$ index.php?magrathea_control=$1&magrathea_action=$2 [QSA,L]
	RewriteRule ^(.*)$ index.php?magrathea_control=$1 [QSA,L]
</IfModule>

# PHP under mod_php/FPM doesn't get the Authorization header otherwise
SetEnvIf Authorization .+ HTTP_AUTHORIZATION=$0

<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "DENY"
	Header always set X-XSS-Protection "1; mode=block"
	Header always set Referrer-Policy "no-referrer-when-downgrade"
	# /docs is Swagger UI: loaded from unpkg.com with an inline init script; the admin embeds it in an iframe
	<If "%{REQUEST_URI} =~ m#^/docs#">
		Header always set X-Frame-Options "SAMEORIGIN"
		Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; connect-src 'self' https://unpkg.com; img-src 'self' data:; frame-ancestors 'self'"
	</If>
	# /admin (dashboard + its API): Prism from cdnjs, /docs in an iframe
	<ElseIf "%{REQUEST_URI} =~ m#^/admin#">
		Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' https://cdnjs.cloudflare.com; frame-src 'self'"
	</ElseIf>
	# /magrathea.php (vendor Magrathea admin) and /setup.php (vendor bootstrap): Bootstrap from jsdelivr, jQuery,
	# inline scripts/styles/handlers, data: images; the admin's OpenAPI page loads Swagger UI from unpkg.com
	<ElseIf "%{REQUEST_URI} =~ m#^/(magrathea|setup)\.php#">
		Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://code.jquery.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; img-src 'self' data:; connect-src 'self' https://cdn.jsdelivr.net https://unpkg.com; frame-ancestors 'none'"
	</ElseIf>
	<Else>
		Header always set Content-Security-Policy "default-src 'self';"
	</Else>
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE application/json text/html text/css application/javascript text/yaml
</IfModule>
