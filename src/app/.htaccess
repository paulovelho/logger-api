# Logger: Apache config. The vhost's DocumentRoot must be <path>/src/app (this folder).
# Needs: a2enmod rewrite headers   (+ deflate, usually on by default)
# Vhost: AllowOverride All   (FileInfo + AuthConfig + Indexes + Limit is enough)

Options -Indexes

# Bootstrap file; executing it directly does nothing useful
<Files "_inc.php">
	Require all denied
</Files>

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Static pages
	RewriteRule ^admin/?$ admin.html [L]
	RewriteRule ^docs/?$ docs.html [L]
	RewriteRule ^help/?$ /docs [R=302,L]

	# PHP sources are never requested directly
	RewriteRule ^(api|features|shared)/ - [F,L]

	# Existing files (admin.*, docs.html, openapi.yaml, index.php) are served as they are
	RewriteCond %{REQUEST_FILENAME} -f
	RewriteRule .+ - [L]

	# Everything else goes to the Magrathea router
	RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/(.*)$ index.php?magrathea_control=$1&magrathea_action=$2&magrathea_params=$3 [QSA,L]
	RewriteRule ^([a-zA-Z0-9_-]+)/(.*)$ index.php?magrathea_control=$1&magrathea_action=$2 [QSA,L]
	RewriteRule ^(.*)$ index.php?magrathea_control=$1 [QSA,L]
</IfModule>

# PHP under mod_php/FPM doesn't get the Authorization header otherwise
SetEnvIf Authorization .+ HTTP_AUTHORIZATION=$0

# Basic auth on the admin (/admin, /admin.html, /admin/logs, /admin/services).
# Only applies when the password file exists, so local Docker runs without it.
# Create it OUTSIDE the DocumentRoot:   sudo htpasswd -c /etc/apache2/.htpasswd-logger admin
# (Different path per instance? Change it in both lines below.)
<IfFile "/etc/apache2/.htpasswd-logger">
	<If "%{REQUEST_URI} =~ m#^/admin#">
		AuthType Basic
		AuthName "Logger admin"
		AuthUserFile /etc/apache2/.htpasswd-logger
		Require valid-user
	</If>
</IfFile>

<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "DENY"
	Header always set X-XSS-Protection "1; mode=block"
	Header always set Referrer-Policy "no-referrer-when-downgrade"
	# /docs is Swagger UI: loaded from unpkg.com with an inline init script
	<If "%{REQUEST_URI} =~ m#^/docs#">
		Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data:"
	</If>
	<Else>
		Header always set Content-Security-Policy "default-src 'self';"
	</Else>
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE application/json text/html text/css application/javascript text/yaml
</IfModule>
