# Local Docker only (docker-compose.yml). Production reads magrathea.conf instead.

# At least 32 bytes (firebase/php-jwt rejects shorter HS256 keys): openssl rand -base64 48
JWT_SECRET=change-this-to-a-strong-random-secret-of-32-bytes-or-more
PORT=3002

DB_HOST=logger_db
DB_NAME=logger
DB_USER=logger
DB_PASSWORD=logger
MYSQL_ROOT_PASSWORD=root
